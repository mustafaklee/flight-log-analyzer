{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "AllowSelfRegistration": false,
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "RateLimitPerMinute": 10,
    "BootstrapAdministrator": {
      "Email": "",
      "Password": "",
      "DisplayName": "Administrator"
    }
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "flightlog",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": true,
    "CreateBucketIfMissing": false
  },
  "Uploads": {
    "MaxFileSizeBytes": 536870912,
    "TempDirectory": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Processing": {
    "Enabled": false,
    "PollInterval": "00:00:02",
    "CancellationCheckInterval": "00:00:05",
    "ParserTimeout": "00:15:00",
    "StaleAfter": "00:30:00",
    "TempDirectory": "",
    "MaxParallelUploads": 8,
    "MaxAutomaticRetries": 3,
    "RetryBaseDelay": "00:00:30",
    "RetryMaxDelay": "00:10:00",
    "AnalysisStaleAfter": "00:10:00"
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "OrphanAfter": "00:30:00",
    "OutboxRetention": "7.00:00:00"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "PrefetchCount": 1
  }
}
