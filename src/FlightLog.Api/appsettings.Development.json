{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=flightlog;Username=flightlog;Password=Change-Me-Postgres-1"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Auth": {
    "AllowSelfRegistration": true
  },
  "Storage": {
    "ServiceUrl": "http://localhost:8333",
    "AccessKey": "flightlog",
    "SecretKey": "Change-Me-Storage-1",
    "CreateBucketIfMissing": true
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Processing": {
    "Enabled": true
  },
  "RabbitMq": {
    "HostName": "localhost",
    "UserName": "flightlog",
    "Password": "Change-Me-RabbitMq-1"
  }
}
