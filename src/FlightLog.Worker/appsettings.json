{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "flightlog",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": true,
    "CreateBucketIfMissing": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Processing": {
    "PollInterval": "00:00:02",
    "CancellationCheckInterval": "00:00:05",
    "ParserTimeout": "00:15:00",
    "StaleAfter": "00:30:00",
    "TempDirectory": "",
    "MaxParallelUploads": 8
  }
}
