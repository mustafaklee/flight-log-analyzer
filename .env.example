# Copy to .env and change the values. .env is git-ignored; never commit real secrets.

POSTGRES_DB=flightlog
POSTGRES_USER=flightlog
POSTGRES_PASSWORD=Change-Me-Postgres-1

# Object storage (SeaweedFS S3 gateway) credentials.
STORAGE_ACCESS_KEY=flightlog
STORAGE_SECRET_KEY=Change-Me-Storage-1

# RabbitMQ (work queue, ADR-0006) credentials.
RABBITMQ_USER=flightlog
RABBITMQ_PASSWORD=Change-Me-RabbitMq-1

# Largest accepted log upload in bytes (default 512 MiB).
UPLOAD_MAX_BYTES=536870912

# First administrator account, created on startup if it does not exist yet.
# The password must satisfy the policy: at least 10 characters with upper case, lower case and a digit.
ADMIN_EMAIL=admin@flightlog.local
ADMIN_PASSWORD=Change-Me-Admin-Password-1

# Allow anyone who can reach the API to create an account (true for local development only).
ALLOW_SELF_REGISTRATION=true

API_PORT=8080

# Web client port (http://localhost:8081).
WEB_PORT=8081

# Map tiles for the flight map. Empty uses OpenStreetMap; MAP_TILE_ORIGIN must match the tile host (CSP img-src).
# Respect the tile provider's usage policy; for heavy use run your own tile server.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_ORIGIN=https://tile.openstreetmap.org
